# Rate limits (R15). limit_req_zone belongs to the http block; site files are
# included inside http {}, so declaring them at the top of this file works.
limit_req_zone $binary_remote_addr zone=azgbdev_ai:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=azgbdev_courses:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=azgbdev_auth:10m rate=10r/m;

server {
    server_name dev.golfbender.app;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/app.azgbscore.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.azgbscore.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    access_log /var/log/nginx/dev-golfbender.access.log;
    error_log  /var/log/nginx/dev-golfbender.error.log;

    root /var/www/azgb-dev/dist;
    index index.html;

    # API keys, kept out of git. Create /etc/nginx/azgb-keys.conf (chmod 600) with:
    #   set $openrouter_key "sk-or-...";
    #   set $golfcourse_key "...";
    include /etc/nginx/azgb-keys.conf;


    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ~* \.(js|css|woff2|woff|ttf|svg|png|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # ── API server (R13): node server/dist/index.mjs on 127.0.0.1:8788 ──
    location /api/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;            # live updates (Server-Sent Events)
        proxy_read_timeout 1h;
        client_max_body_size 2m;
    }

    # Sign-in emails: slow down scripted requests before they reach the API
    location = /api/auth/request {
        limit_req zone=azgbdev_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── API proxies (R15): keys are added here and never reach browsers ──
    # Only signed-in organisers and scorers may use them (checked by the API).
    location = /_azgb_auth_check {
        internal;
        proxy_pass http://127.0.0.1:8788/api/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location = /proxy/openrouter/chat/completions {
        limit_except POST { deny all; }
        auth_request /_azgb_auth_check;
        limit_req zone=azgbdev_ai burst=10 nodelay;
        proxy_pass https://openrouter.ai/api/v1/chat/completions;
        proxy_set_header Authorization "Bearer $openrouter_key";
        proxy_set_header Host openrouter.ai;
        proxy_set_header Cookie "";
        proxy_ssl_server_name on;
        client_max_body_size 64k;
    }

    location = /proxy/golfcourse/v1/courses {
        limit_except GET { deny all; }
        auth_request /_azgb_auth_check;
        limit_req zone=azgbdev_courses burst=10 nodelay;
        proxy_pass https://api.golfcourseapi.com/v1/courses$is_args$args;
        proxy_set_header Authorization "Key $golfcourse_key";
        proxy_set_header Host api.golfcourseapi.com;
        proxy_set_header Cookie "";
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers. nginx ignores server-level add_header inside any
    # location that sets its own, so the locations above repeat them.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}

server {
    listen 80;
    server_name dev.golfbender.app;
    return 301 https://$host$request_uri;
}
