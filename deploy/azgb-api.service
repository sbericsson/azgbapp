# Golf Bender API (R13). Install:
#   sudo cp deploy/azgb-api.service /etc/systemd/system/azgb-api.service
#   (edit User=, WorkingDirectory= and the node path to match the server: `which node`)
#   sudo systemctl daemon-reload && sudo systemctl enable --now azgb-api
# Logs: journalctl -u azgb-api -f
[Unit]
Description=Golf Bender API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/azgb
EnvironmentFile=/etc/azgb/api.env
ExecStart=/usr/bin/node server/dist/index.mjs
Restart=on-failure
RestartSec=2

# Hardening: the process can only write its database directory
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/azgb

[Install]
WantedBy=multi-user.target
