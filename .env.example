# ─── Local development ──────────────────────────────────────────────────────
# Copy to .env.local. Nothing here is VITE_-prefixed any more: no secret is
# compiled into the browser bundle (R15). Vite's dev server reads these keys
# and adds them in its /proxy/* routes; on the VPS, nginx does the same.
#
#   npm run dev:server   # API on 127.0.0.1:8787 (settings: server/.env, see server/.env.example)
#   npm run dev          # app on localhost:5173, proxies /api to the API
# ────────────────────────────────────────────────────────────────────────────

# AI commentary (optional; without it the app uses built-in commentary)
OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-20261017

# Course search (optional) — free key from golfcourseapi.com
GOLF_COURSE_API_KEY=

# Only for the one-time Firestore import (npm run import:firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
