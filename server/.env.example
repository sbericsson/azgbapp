# Golf Bender API settings. On the VPS: /etc/azgb/api.env (chmod 600).
# Locally: copy to server/.env for `npm run dev:server`.

PORT=8787
DB_PATH=/var/lib/azgb/azgb.db

# Public address of the app, used in emailed sign-in links
APP_URL=https://app.example.com

# App admins: can open and manage every tournament (comma-separated)
APP_ADMIN_EMAILS=you@example.com

# Optional outgoing email. Leave SMTP_URL empty and organisers copy, text or
# email sign-in links themselves (the usual setup). Set it to also let people
# request a link by email and let organisers email a group's link, e.g.
#   smtps://USER:PASSWORD@smtp.gmail.com:465   (Gmail with an app password)
SMTP_URL=
MAIL_FROM="Golf Bender <golf@example.com>"

# Set to false to stop anyone with a verified email creating tournaments at /create
ALLOW_SELF_SERVICE=true
