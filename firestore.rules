rules_version = '2';
// Firestore is retired: the app now uses its own API server and SQLite on the
// VPS (R13). Deploy these rules AFTER running server/scripts/import-firestore.ts,
// so the old data (including every PIN) stops being publicly readable:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
