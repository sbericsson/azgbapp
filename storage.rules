rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The app now stores tournament logos in Firestore (as data URLs), so
    // nothing writes to Storage. Writes were previously open to anyone
    // (REPO_REVIEW B22). Reads stay open on the old logo path in case an
    // older tournament's logoUrl still points here.
    match /tournaments/{tournamentId}/logo {
      allow read: if true;
      allow write: if false;
    }
  }
}
